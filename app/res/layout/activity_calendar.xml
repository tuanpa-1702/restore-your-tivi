<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar screen on the 960x540 dp stage: day details on the left, month grid (MonthView, added in code) on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.tivibox.home.MeshBackgroundView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="960dp"
        android:layout_height="540dp"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="28dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Lịch âm dương"
            android:textColor="#FFFFFFFF"
            android:textSize="26dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="◀ ▶ ▲ ▼ chọn ngày · CH+ / CH− đổi tháng · OK để về hôm nay · BACK để thoát"
            android:textColor="#A6FFFFFF"
            android:textSize="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="340dp"
                android:layout_height="match_parent"
                android:background="@drawable/info_card_bg"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/big_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFFFF"
                        android:textSize="76dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/weekday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFFFFFFF"
                            android:textSize="20dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/solar_month"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#D9FFFFFF"
                            android:textSize="15dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#24FFFFFF" />

                <TextView
                    style="@style/InfoLabel"
                    android:layout_marginTop="10dp"
                    android:text="ÂM LỊCH" />

                <TextView
                    android:id="@+id/lunar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFD27A"
                    android:textSize="22dp" />

                <TextView
                    android:id="@+id/lunar_year"
                    style="@style/InfoText" />

                <TextView
                    android:id="@+id/can_chi"
                    style="@style/InfoText"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tiet_khi"
                    style="@style/InfoText" />

                <TextView
                    android:id="@+id/star"
                    style="@style/InfoText"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/clash"
                    style="@style/InfoText" />

                <TextView
                    style="@style/InfoLabel"
                    android:layout_marginTop="10dp"
                    android:text="GIỜ HOÀNG ĐẠO" />

                <TextView
                    android:id="@+id/good_hours"
                    style="@style/InfoText"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/holiday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/holiday_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="#FFFFC857"
                    android:textSize="13dp"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/month_holder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
