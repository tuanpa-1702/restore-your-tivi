<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.tivibox.home.MeshBackgroundView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="32dp"
        android:paddingEnd="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Ứng dụng"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="OK để mở · Giữ OK để di chuyển hoặc thêm vào dock · Back để về màn hình chính"
            android:textColor="#A6FFFFFF"
            android:textSize="12sp" />

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:drawSelectorOnTop="true"
            android:horizontalSpacing="14dp"
            android:listSelector="@drawable/app_selector"
            android:numColumns="6"
            android:paddingTop="6dp"
            android:paddingBottom="32dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="14dp" />
    </LinearLayout>
</FrameLayout>
