{
  "$description": "Tivi Home design tokens. Units: dp on a 960x540 dp stage (1 dp = 1 CSS px in the reference HTML). Colors are hex or rgba.",
  "stage": {
    "width": 960,
    "height": 540,
    "paddingX": 40,
    "paddingTop": 32,
    "scaleToFit": "Scale the whole stage uniformly to the screen (letterbox, never reflow). 1280x720 TV = x1.333, 1920x1080 = x2."
  },
  "color": {
    "text": {
      "primary": "#FFFFFF",
      "secondary": "rgba(255,255,255,0.70)",
      "tertiary": "rgba(255,255,255,0.55)",
      "onFocus": "#15151C",
      "onFocusSecondary": "rgba(21,21,28,0.70)"
    },
    "glass": {
      "cardFill": "rgba(255,255,255,0.11)",
      "cardBorder": "rgba(255,255,255,0.20)",
      "tileFill": "rgba(255,255,255,0.13)",
      "tileBorder": "rgba(255,255,255,0.24)",
      "badgeFill": "rgba(255,255,255,0.15)",
      "badgeBorder": "rgba(255,255,255,0.24)",
      "divider": "rgba(255,255,255,0.14)"
    },
    "focus": {
      "ring": "#8EE08F",
      "fill": "#F3EEE8",
      "movingRing": "#FFC857"
    },
    "accent": {
      "greetingDot": "#6EE7A8",
      "today": "#8EE08F",
      "onToday": "#0F3B1C",
      "sunday": "#F7A1B5",
      "lunarFirstDay": "#FFD27A",
      "amber": "#FFC857",
      "youtubeIconBox": "#0B0B0B",
      "appBrand": "#5B3FE0"
    },
    "weatherIcon": {
      "sun": "#FFC53D",
      "moon": "#F6E7A6",
      "cloudLight": "#F2F5FA",
      "cloudGrey": "#C9D2E0",
      "cloudBack": "#AEB9CB",
      "rain": "#6CB8FF",
      "drizzle": "#8CCBFF",
      "bolt": "#FFD54A"
    }
  },
  "background": {
    "$description": "Mesh of 5 radial blobs over a base color, drawn in this order (last on top). x,y are fractions of stage width/height; radius is a fraction of stage WIDTH. Each blob: color at 0, color at 50% alpha at 45% of radius, transparent at radius.",
    "timHong": {
      "label": "Tím hồng (default)",
      "base": "#0C0A22",
      "blobs": [
        { "color": "#6A4BF5", "x": 0.12, "y": 0.02, "radius": 0.62 },
        { "color": "#E2468F", "x": 0.98, "y": 0.02, "radius": 0.50 },
        { "color": "#F08A2E", "x": 0.22, "y": 1.08, "radius": 0.32 },
        { "color": "#16A6B6", "x": 0.80, "y": 1.02, "radius": 0.52 },
        { "color": "#0A0A1C", "x": 0.55, "y": 0.30, "radius": 0.30 }
      ]
    },
    "daiDuong": {
      "label": "Đại dương",
      "base": "#051421",
      "blobs": [
        { "color": "#1D4ED8", "x": 0.10, "y": 0.00, "radius": 0.60 },
        { "color": "#0EA5E9", "x": 0.95, "y": 0.05, "radius": 0.45 },
        { "color": "#14B8A6", "x": 0.30, "y": 1.05, "radius": 0.40 },
        { "color": "#22D3EE", "x": 0.85, "y": 1.00, "radius": 0.45 },
        { "color": "#041019", "x": 0.55, "y": 0.32, "radius": 0.30 }
      ]
    },
    "hoangHon": {
      "label": "Hoàng hôn",
      "base": "#1A0A14",
      "blobs": [
        { "color": "#F97316", "x": 0.10, "y": 0.02, "radius": 0.55 },
        { "color": "#E11D48", "x": 0.95, "y": 0.05, "radius": 0.50 },
        { "color": "#7C3AED", "x": 0.25, "y": 1.05, "radius": 0.40 },
        { "color": "#F59E0B", "x": 0.85, "y": 1.02, "radius": 0.45 },
        { "color": "#12060C", "x": 0.55, "y": 0.32, "radius": 0.30 }
      ]
    }
  },
  "font": {
    "family": "Roboto (Android sans-serif)",
    "weights": { "thin": 100, "light": 300, "regular": 400, "medium": 500, "bold": 700 },
    "scale": {
      "clock":          { "size": 138, "weight": 300, "letterSpacing": "-0.02em" },
      "screenTitle":    { "size": 26,  "weight": 700 },
      "weekday":        { "size": 34,  "weight": 700 },
      "bigNumber":      { "size": 54,  "weight": 300, "use": "temperature, choice cards" },
      "countdown":      { "size": 96,  "weight": 300 },
      "tileLabel":      { "size": 22,  "weight": 700, "shrinkTo": 14 },
      "date":           { "size": 17,  "weight": 400 },
      "cardTitle":      { "size": 15,  "weight": 500 },
      "greeting":       { "size": 13.5,"weight": 500 },
      "body":           { "size": 13,  "weight": 400 },
      "lunarLine":      { "size": 12.5,"weight": 400 },
      "calendarDay":    { "size": 12,  "weight": 500 },
      "caption":        { "size": 10,  "weight": 400 },
      "calendarHeader": { "size": 8.5, "weight": 500 },
      "lunarDay":       { "size": 7.5, "weight": 400 }
    }
  },
  "radius": { "card": 18, "tile": 18, "tileFocusOuter": 20, "tileFocusInner": 17, "iconBox": 10, "badge": 8, "key": 12, "pinBox": 8, "todayCell": 6, "pill": 999 },
  "border": { "hairline": 1, "focusRing": 3, "pinCursor": 2 },
  "spacing": { "cardPadding": 16, "gap": 14, "dockGap": 14, "cardsToDock": 17, "keyGap": 10 },
  "size": {
    "topBar": 32, "roundButton": 32, "heroZone": 142, "cardRow": 199, "dockTile": 79,
    "tileIconBox": 38, "badge": 26, "choiceCard": [150, 130], "wideChoiceCard": [200, 130],
    "key": [64, 42], "pinBox": [30, 40]
  },
  "motion": {
    "focusDurationMs": 150,
    "focusScale": { "dockTile": 1.035, "choiceCard": 1.06, "roundButton": 1.12 }
  }
}
